# Supabase Cloud Sync Configuration
# Obtain your project URL and anon public key from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Gemini API Key (For AI Bean Bag Photo OCR & Flavor Scanner)
# Obtain a free API key from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here
